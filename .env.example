APP_ENV=development
APP_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DATA_ENCRYPTION_KEY=GENERATE_FERNET_KEY
TOKEN_ENCRYPTION_KEY=GENERATE_ANOTHER_FERNET_KEY
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
DATABASE_URL=postgresql://carecircle:replace-me@db:5432/carecircle
SESSION_HOURS=12

# Bootstrap the first operator once, then unset the password.
BOOTSTRAP_OPERATOR_EMAIL=operator@example.invalid
BOOTSTRAP_OPERATOR_PASSWORD=REPLACE_WITH_UNIQUE_12_PLUS_CHARACTER_PASSWORD

# Editable cost assumptions; values are configuration, not market claims.
DEFAULT_HOURLY_PRICE_INR=300
DEFAULT_CONTRIBUTOR_PAYOUT_INR=240
MAX_MONTHLY_CLIENT_SPEND_INR=100000
OPERATOR_COST_PER_HOUR_INR=240
MESSAGE_COST_INR=2
ALERT_HR_LOW_BPM=40
ALERT_HR_HIGH_BPM=140
ALERT_SPO2_LOW_PERCENT=90

# WhatsApp Cloud API. Configure approved templates before enabling outbound notices.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_TEMPLATE_BOOKING=
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_ALERT=

# Voice processing sends audio/transcript to these configured services only after consent.
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=

# Fitbit Web API (OAuth app and approved scopes required).
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:8000/api/integrations/fitbit/callback

# Razorpay TEST keys only for local/test use. Live payments require explicit production review.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false

# Only configure an approved, contractually authorized provider adapter.
PARTNER_ADAPTER_URL=
INTEGRATION_INGEST_KEY=

# Direct helpdesk contact shown to client and elder accounts (never use a placeholder number).
HELPDESK_NAME=CareCircle helpdesk
HELPDESK_PHONE=
HELPDESK_EMAIL=
HELPDESK_HOURS=

# Required to register a Main admin profile. Keep this secret; never commit a live value.
ADMIN_INVITE_CODE=
